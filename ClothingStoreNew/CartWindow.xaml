<Window x:Class="ClothingStoreNew.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на приём"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="CanMinimize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#1E293B"
                CornerRadius="20"
                Padding="25"
                Margin="0,0,0,20">

            <DockPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="🦷"
                               FontSize="36"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <StackPanel>

                        <TextBlock Text="Dental Clinic"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Выбранные стоматологические услуги"
                                   FontSize="15"
                                   Foreground="#CBD5E1"/>
                    </StackPanel>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- SERVICES GRID -->
        <Border Grid.Row="1"
                Background="#1E293B"
                CornerRadius="20"
                Padding="15">

            <DataGrid x:Name="CartGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="#1E293B"
                      Foreground="White"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#273449"
                      FontSize="15">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#334155"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Услуга"
                                        Binding="{Binding Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Стоимость"
                                        Binding="{Binding Price}"
                                        Width="150" />

                    <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Quantity}"
                                        Width="120" />

                    <DataGridTextColumn Header="Итого"
                                        Binding="{Binding Total}"
                                        Width="150" />

                    <DataGridTemplateColumn Header="Действие"
                                            Width="150">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="Удалить"
                                        Height="36"
                                        Background="#DC2626"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="Remove_Click"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#1E293B"
                CornerRadius="20"
                Padding="20"
                Margin="0,20,0,0">

            <DockPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <TextBlock Text="Общая стоимость:"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="TotalText"
                               Margin="15,0,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#10B981"/>

                </StackPanel>

                <Button Content="Подтвердить запись"
                        Width="240"
                        Height="55"
                        DockPanel.Dock="Right"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Checkout_Click"/>

            </DockPanel>

        </Border>

    </Grid>
</Window>