<Window x:Class="ClothingStoreNew.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата услуг"
        Height="500"
        Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>

        <Border Background="White"
                CornerRadius="20"
                Padding="25"
                Width="340"
                Height="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Оплата стоматологических услуг"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0F766E"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="Отсканируйте QR-код для подтверждения оплаты"
                           Margin="0,15,0,20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#64748B"/>

                <Border BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10">

                    <Image x:Name="QrImage"
                           Width="220"
                           Height="220"
                           HorizontalAlignment="Center"/>

                </Border>

                <TextBlock Text="DentalCare Clinic"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#0F766E"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>