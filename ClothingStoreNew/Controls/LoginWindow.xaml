<Window x:Class="ClothingStoreNew.Controls.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DentalCare Clinic - Вход"
        Height="420"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>

        <Border Width="340"
                Padding="30"
                Background="White"
                CornerRadius="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="DentalCare Clinic"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F766E"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Вход в систему стоматологической клиники"
                           Margin="0,8,0,25"
                           TextAlignment="Center"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailBox"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Button Content="Войти в систему"
                        Click="Login_Click"
                        Margin="0,10,0,0"/>

                <Button Content="Создать аккаунт"
                        Click="Register_Click"
                        Background="#334155"
                        Margin="0,10,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>