<Window x:Class="ClothingStoreNew.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dental Clinic - Панель администратора"
        Height="950"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="CanMinimize">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Border Grid.Column="0"
                Background="#1E293B"
                CornerRadius="25"
                Padding="20">

            <TabControl Background="#1E293B"
                        Foreground="White"
                        BorderThickness="0">

                <!-- SERVICES -->
                <TabItem Header="Стоматологические услуги">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="ProductsGrid"
                                  AutoGenerateColumns="True"
                                  SelectionChanged="ProductsGrid_SelectionChanged"
                                  Background="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  RowBackground="#1E293B"
                                  AlternatingRowBackground="#273449"
                                  FontSize="14">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Height" Value="42"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>

                            </DataGrid.Resources>

                        </DataGrid>

                        <WrapPanel Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0">

                            <Button Content="Добавить услугу"
                                    Width="180"
                                    Height="45"
                                    Margin="5"
                                    Background="#10B981"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AddProduct"/>

                            <Button Content="Обновить услугу"
                                    Width="180"
                                    Height="45"
                                    Margin="5"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="UpdateProduct"/>

                            <Button Content="Удалить услугу"
                                    Width="180"
                                    Height="45"
                                    Margin="5"
                                    Background="#DC2626"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="DeleteProduct"/>

                        </WrapPanel>

                    </Grid>

                </TabItem>

                <!-- PATIENTS -->
                <TabItem Header="Пациенты">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="UsersGrid"
                                  AutoGenerateColumns="True"
                                  Background="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  RowBackground="#1E293B"
                                  AlternatingRowBackground="#273449"
                                  FontSize="14"/>

                        <StackPanel Grid.Row="1"
                                    Margin="0,20,0,0">

                            <WrapPanel Margin="0,0,0,10">

                                <TextBox x:Name="NewNameBox"
                                         Width="220"
                                         Height="40"
                                         Margin="5"
                                         Padding="10"
                                         Background="#334155"
                                         Foreground="White"
                                         BorderThickness="0"/>

                                <TextBox x:Name="NewEmailBox"
                                         Width="260"
                                         Height="40"
                                         Margin="5"
                                         Padding="10"
                                         Background="#334155"
                                         Foreground="White"
                                         BorderThickness="0"/>

                                <TextBox x:Name="NewPasswordBox"
                                         Width="220"
                                         Height="40"
                                         Margin="5"
                                         Padding="10"
                                         Background="#334155"
                                         Foreground="White"
                                         BorderThickness="0"/>

                                <Button Content="Добавить пациента"
                                        Width="190"
                                        Height="40"
                                        Margin="5"
                                        Background="#10B981"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="AddUser"/>

                            </WrapPanel>

                            <WrapPanel>

                                <ComboBox x:Name="RoleBox"
                                          Width="220"
                                          Height="40"
                                          Margin="5"
                                          Background="#334155"
                                          Foreground="White"
                                          BorderThickness="0">

                                    <ComboBoxItem Content="User"/>
                                    <ComboBoxItem Content="Admin"/>

                                </ComboBox>

                                <Button Content="Изменить роль"
                                        Width="190"
                                        Height="40"
                                        Margin="5"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ChangeRole"/>

                                <Button Content="Удалить пациента"
                                        Width="190"
                                        Height="40"
                                        Margin="5"
                                        Background="#DC2626"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="DeleteUser"/>

                            </WrapPanel>

                        </StackPanel>

                    </Grid>

                </TabItem>

                <!-- APPOINTMENTS -->
                <TabItem Header="Записи">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="OrdersGrid"
                                  AutoGenerateColumns="True"
                                  SelectionChanged="OrdersGrid_SelectionChanged"
                                  Background="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  RowBackground="#1E293B"
                                  AlternatingRowBackground="#273449"/>

                        <DataGrid x:Name="OrderItemsGrid"
                                  Grid.Row="1"
                                  Margin="0,15,0,0"
                                  AutoGenerateColumns="True"
                                  Background="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  RowBackground="#1E293B"
                                  AlternatingRowBackground="#273449"/>

                        <WrapPanel Grid.Row="2"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0">

                            <ComboBox x:Name="OrderStatusBox"
                                      Width="240"
                                      Height="42"
                                      Margin="5"
                                      Background="#334155"
                                      Foreground="White"
                                      BorderThickness="0">

                                <ComboBoxItem Content="Новая запись"/>
                                <ComboBoxItem Content="Подтверждено"/>
                                <ComboBoxItem Content="Пациент пришёл"/>
                                <ComboBoxItem Content="Приём завершён"/>

                            </ComboBox>

                            <Button Content="Обновить статус"
                                    Width="220"
                                    Height="42"
                                    Margin="5"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="UpdateOrderStatus"/>

                        </WrapPanel>

                    </Grid>

                </TabItem>

            </TabControl>

        </Border>

        <!-- RIGHT PANEL -->
        <Border Grid.Column="1"
                Margin="20,0,0,0"
                Background="#1E293B"
                CornerRadius="25"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,25">

                        <TextBlock Text="🦷"
                                   FontSize="36"
                                   Margin="0,0,15,0"/>

                        <StackPanel>

                            <TextBlock Text="Dental Clinic"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Редактор стоматологических услуг"
                                       FontSize="15"
                                       Foreground="#CBD5E1"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- NAME -->
                    <TextBlock Text="Название услуги"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBox x:Name="NameBox"
                             Height="42"
                             Margin="0,8,0,18"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                    <!-- PRICE -->
                    <TextBlock Text="Стоимость"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBox x:Name="PriceBox"
                             Height="42"
                             Margin="0,8,0,18"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="Описание процедуры"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBox x:Name="DescriptionBox"
                             Height="130"
                             Margin="0,8,0,18"
                             Padding="12"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                    <!-- STOCK -->
                    <TextBlock Text="Количество посещений"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBox x:Name="StockBox"
                             Height="42"
                             Margin="0,8,0,18"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                    <!-- CATEGORY -->
                    <TextBlock Text="Категория лечения"
                               Foreground="White"
                               FontSize="15"/>

                    <ComboBox x:Name="CategoryBox"
                              Height="42"
                              Margin="0,8,0,18"
                              Background="#334155"
                              Foreground="White"
                              BorderThickness="0"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                    <!-- BRAND -->
                    <TextBlock Text="Специалист"
                               Foreground="White"
                               FontSize="15"/>

                    <ComboBox x:Name="BrandBox"
                              Height="42"
                              Margin="0,8,0,18"
                              Background="#334155"
                              Foreground="White"
                              BorderThickness="0"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                    <!-- IMAGE -->
                    <Button Content="Выбрать изображение"
                            Height="48"
                            Margin="0,15,0,15"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SelectImage_Click"/>

                    <Border Background="#334155"
                            CornerRadius="15"
                            Padding="15">

                        <TextBlock x:Name="ImagePathText"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   Text="Изображение не выбрано"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>