<Window x:Class="ClothingStoreNew.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор услуги"
        Height="850"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="CanMinimize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Background="#1E293B"
                    CornerRadius="20"
                    Padding="25"
                    Margin="0,0,0,25">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="🦷"
                               FontSize="38"
                               Margin="0,0,15,0"/>

                    <StackPanel>

                        <TextBlock Text="Dental Clinic"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Редактирование стоматологической услуги"
                                   FontSize="15"
                                   Foreground="#CBD5E1"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- NAME -->
            <Border Grid.Row="1"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Название услуги"
                               FontSize="15"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="NameBox"
                             Height="42"
                             FontSize="16"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                </StackPanel>

            </Border>

            <!-- PRICE -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Стоимость услуги"
                               FontSize="15"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="PriceBox"
                             Height="42"
                             FontSize="16"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"/>

                </StackPanel>

            </Border>

            <!-- CATEGORY -->
            <Border Grid.Row="3"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Категория процедуры"
                               FontSize="15"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="CategoryBox"
                              Height="42"
                              FontSize="15"
                              Background="#334155"
                              Foreground="White"
                              BorderThickness="0"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                </StackPanel>

            </Border>

            <!-- BRAND -->
            <Border Grid.Row="4"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Специалист / врач"
                               FontSize="15"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="BrandBox"
                              Height="42"
                              FontSize="15"
                              Background="#334155"
                              Foreground="White"
                              BorderThickness="0"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                </StackPanel>

            </Border>

            <!-- IMAGE -->
            <Border Grid.Row="5"
                    Background="#1E293B"
                    CornerRadius="20"
                    Padding="25"
                    Margin="0,0,0,25">

                <StackPanel>

                    <TextBlock Text="Изображение услуги"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>

                    <Border Background="#334155"
                            CornerRadius="15"
                            Padding="15">

                        <Image x:Name="PreviewImage"
                               Height="250"
                               Stretch="Uniform"/>

                    </Border>

                    <TextBlock x:Name="ImagePathText"
                               Margin="0,15,0,15"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               Text="Изображение не выбрано"/>

                    <WrapPanel>

                        <Button Content="Выбрать изображение"
                                Width="190"
                                Height="45"
                                Margin="0,0,10,0"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="SelectImage_Click"/>

                        <Button Content="Удалить изображение"
                                Width="190"
                                Height="45"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="RemoveImage_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

            <!-- BUTTONS -->
            <Border Grid.Row="6"
                    Background="#1E293B"
                    CornerRadius="20"
                    Padding="25">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Сохранить услугу"
                            Width="220"
                            Height="55"
                            Margin="0,0,15,0"
                            Background="#10B981"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Save_Click"/>

                    <Button Content="Удалить услугу"
                            Width="220"
                            Height="55"
                            Background="#DC2626"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Delete_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>
</Window>